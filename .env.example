# ==============================================================================
# HarborAI Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# --- Backend Database ---
# PostgreSQL async connection (used by FastAPI / SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://harborai:harborai@localhost:5432/harborai
# PostgreSQL sync connection (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://harborai:harborai@localhost:5432/harborai
# Dedicated PostgreSQL test database (used by pytest suite)
TEST_DATABASE_URL=postgresql+asyncpg://harborai:harborai@localhost:5432/harborai_test

# --- Backend App Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED_DB=true
RANDOM_SEED=42
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Future Phase Services (Deferred) ---
# IBM_WATSONX_API_KEY=
# IBM_WATSONX_PROJECT_ID=
# IBM_WATSONX_URL=

